{
  "name": "smart-parking-dbms",
  "version": "1.0.0",
  "private": true,
  "description": "Smart parking management mini project with Next.js, SQLite RBAC and MongoDB operations",
  "scripts": {
    "dev": "concurrently -k \"npm:api\" \"npm:web\"",
    "api": "node server.js",
    "web": "next dev -p 3000",
    "build": "next build",
    "start": "concurrently -k \"npm:api\" \"npm:web:start\"",
    "web:start": "next start -p 3000"
  },
  "dependencies": {
    "mongodb": "^6.20.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": { "concurrently": "^9.2.1", "typescript": "^5.9.3", "@types/node": "^22.18.6", "@types/react": "^19.1.13", "@types/react-dom": "^19.1.9" },
  "engines": { "node": ">=22.5" }
}
